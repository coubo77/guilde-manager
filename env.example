# Copiez ce fichier en ".env" et remplissez les valeurs (ne JAMAIS commiter le .env réel)

# Token du bot Discord (Portail développeur Discord > votre application > Bot > Reset Token)
DISCORD_BOT_TOKEN=colle_ton_token_ici

# Optionnel : ID du serveur (guilde) Discord. S'il est renseigné, le serveur essaiera
# de récupérer le pseudo/surnom DU SERVEUR (nickname) en plus du profil global.
DISCORD_GUILD_ID=

# Port d'écoute du backend
PORT=3001

# Origine autorisée pour les requêtes CORS (l'URL depuis laquelle l'app front est servie)
# Mettez "*" en développement local si besoin, mais restreignez-le en production.
CORS_ORIGIN=*
