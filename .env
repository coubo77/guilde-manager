# Copiez ce fichier en ".env" et remplissez les valeurs (ne JAMAIS commiter le .env réel)

# Token du bot Discord (Portail développeur Discord > votre application > Bot > Reset Token)
DISCORD_BOT_TOKEN=colle_ton_token_ici

# ID du serveur (guilde) Discord. OBLIGATOIRE pour vérifier le rôle des joueurs
# qui se connectent, et pour récupérer leur surnom du serveur.
DISCORD_GUILD_ID=1355632831333798200

# Nom du rôle Discord requis pour qu'un joueur puisse se connecter et rejoindre
# automatiquement la liste des joueurs.
DISCORD_REQUIRED_ROLE_NAME=Aion 2

# Identifiants OAuth2 (Portail développeur Discord > votre application > OAuth2 > Client ID / Client Secret)
# Nécessaires pour le bouton "Se connecter avec Discord".
DISCORD_CLIENT_ID=1536432642751463517
DISCORD_CLIENT_SECRET=de78yb4JFQL9e8hWYNhRBiYrBRnNjvOV

# Optionnel : URL de redirection OAuth2 exacte, si vous voulez la forcer plutôt que
# la laisser se déduire automatiquement de l'adresse du backend.
# Doit correspondre EXACTEMENT à une "Redirect" enregistrée sur le portail développeur Discord.
# Exemple : https://guilde.votredomaine.com/auth/discord/callback
DISCORD_REDIRECT_URI=

# Port d'écoute du backend
PORT=3001

# Origine autorisée pour les requêtes CORS (l'URL depuis laquelle l'app front est servie)
# Mettez "*" en développement local si besoin, mais restreignez-le en production.
CORS_ORIGIN=*
